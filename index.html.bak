</main>

<footer style="border-top:1px solid rgba(23,23,43,.08);padding:18px 24px">
  <div class="site-footer">
    <div><strong>UB Tutoring</strong><div style="color:var(--muted);font-size:.92rem">Online GCSE &amp; A-Level Economics Tutoring.</div></div>
    <nav class="footer-links" aria-label="Footer">
      <a href="#about">About</a>
      <a href="#services">Services</a>
      <a href="#contact">Contact</a>
      <a href="#testimonials">Testimonials</a>
    </nav>
    <div style="color:var(--muted);font-size:.9rem">&copy; <span id="year"></span> UB Tutoring. All rights reserved.</div>
  </div>
</footer>

<script>
(function(){
  const year=document.getElementById('year'); if(year) year.textContent=new Date().getFullYear();
  const header=document.getElementById('header');
  const toggle=document.getElementById('menu-toggle');
  const menu=document.getElementById('mobile-menu');
  const mobileLinks=menu.querySelectorAll('a');
  function openMenu(){menu.classList.add('open');toggle.setAttribute('aria-expanded','true');menu.setAttribute('aria-hidden','false')}
  function closeMenu(){menu.classList.remove('open');toggle.setAttribute('aria-expanded','false');menu.setAttribute('aria-hidden','true')}
  toggle.addEventListener('click',()=>menu.classList.contains('open')?closeMenu():openMenu());
  mobileLinks.forEach(a=>a.addEventListener('click',()=>{closeMenu()}));
  window.addEventListener('scroll',()=>{header.classList.toggle('scrolled',window.scrollY>20)},{passive:true});
  const io=new IntersectionObserver((entries)=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target)}});},{threshold:.12,rootMargin:'0px 0px -6% 0px'});
  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

  const carousel=document.getElementById('testimonial-carousel');
  const scrollEl=document.getElementById('testimonial-scroll');
  const dotsEl=document.getElementById('testimonial-dots');
  if(carousel && scrollEl && dotsEl){
    const slides=scrollEl.querySelectorAll('.quote');
    const dotButtons=[];
    slides.forEach((_,i)=>{
      const b=document.createElement('button');
      b.setAttribute('aria-label','Testimonial '+(i+1));
      dotsEl.appendChild(b);
      dotButtons.push(b);
      b.addEventListener('click',()=>{slides[i].scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'})});
    });
    const updateDots=()=>{
      const sl=scrollEl.scrollLeft;
      const w=scrollEl.clientWidth;
      let idx=0;
      slides.forEach((s,i)=>{
        const offset=Math.abs((s.offsetLeft + s.offsetWidth/2)-(sl + w/2));
        if(offset< (Math.abs((slides[idx].offsetLeft + slides[idx].offsetWidth/2)-(sl + w/2))+1)) idx=i;
      });
      dotButtons.forEach((b,i)=>b.classList.toggle('active',i===idx));
    };
    scrollEl.addEventListener('scroll',updateDots,{passive:true});
    updateDots();
    let busy=false;
    const advance=()=>{
      if(busy) return;
      busy=true;
      const sl=scrollEl.scrollLeft;
      const w=scrollEl.clientWidth;
      const maxScroll=scrollEl.scrollWidth-w;
      if(maxScroll-sl<40){
        scrollEl.scrollTo({left:0,behavior:'smooth'});
      }else{
        scrollEl.scrollBy({left:w*0.72,behavior:'smooth'});
      }
      setTimeout(()=>{busy=false;updateDots()},700);
    };
    let timer=setInterval(advance,15000);
    const resetTimer=()=>{
      clearInterval(timer);
      timer=setInterval(advance,15000);
      updateDots();
    };
    scrollEl.addEventListener('pointerdown',resetTimer);
    scrollEl.addEventListener('wheel',resetTimer);
    scrollEl.addEventListener('touchstart',resetTimer);
    scrollEl.addEventListener('keydown',resetTimer);
  }
})();
</script>
</body>
</html>

